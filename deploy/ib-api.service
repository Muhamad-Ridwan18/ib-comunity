[Unit]
Description=IB Community API
Documentation=https://github.com/ib-community
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/ib-community/backend
EnvironmentFile=/var/www/ib-community/backend/.env
ExecStart=/var/www/ib-community/backend/bin/api
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
TimeoutStopSec=20
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
