# Santara Pips — root env example
# Laravel: use backend/.env.example → backend/.env
# Frontend: copy values below into frontend/.env.local

# --- Frontend ---
NEXT_PUBLIC_APP_NAME=Santara Pips
NEXT_PUBLIC_API_URL=http://localhost:8081/v1
TWELVE_DATA_API_KEY=your_twelve_data_api_key

# Local Next rewrite target only if you proxy /v1 (optional)
# API_PROXY_TARGET=http://127.0.0.1:8081

# --- Shared ---
FRONTEND_URL=http://localhost:3000

# Legacy Go API is archived at backups/golang-api/ (was :8080)
