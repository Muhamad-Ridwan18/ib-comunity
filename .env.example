# IB Community — root env example
# Copy to backend/.env and frontend/.env.local as needed

# --- Backend ---
APP_NAME=IB Community
APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080
# Comma-separated allowlist for production CORS
FRONTEND_URL=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

DB_HOST=localhost
DB_PORT=5432
DB_USER=ibcommunity
DB_PASSWORD=ibcommunity
DB_NAME=ib_community
DB_SSLMODE=disable

# Dev placeholder OK locally. Production: openssl rand -hex 32 (≥32 chars)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=../storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/storage

AI_FAIL_THRESHOLD=3

# Demo users/content seed automatically when APP_ENV=development.
# In production seeds are off unless you explicitly set:
# SEED_DEMO=true

# --- Frontend (.env.local) ---
# Use /v1 locally (Next.js proxies to Go). On Vercel set full API URL.
NEXT_PUBLIC_API_URL=/v1
NEXT_PUBLIC_APP_NAME=IB Community
API_PROXY_TARGET=http://127.0.0.1:8080
TWELVE_DATA_API_KEY=your_twelve_data_api_key
